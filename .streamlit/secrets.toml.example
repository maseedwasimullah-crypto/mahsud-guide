# MAHSUDo-guide — example Streamlit secrets (placeholders only).
#
# Local use:  copy this file to .streamlit/secrets.toml and fill in values.
# Streamlit Cloud: paste the same keys into the app's "Secrets" editor
#   (App -> Settings -> Secrets). The real secrets.toml is git-ignored.

# Required for a stable deployment — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY = "CHANGE_ME_generate_a_long_random_string"

# Optional: only used to seed an admin when the database is first created.
# ADMIN_SEED_EMAIL = "admin@example.com"
# ADMIN_SEED_PASSWORD = "CHANGE_ME_use_a_strong_password"

# AI provider (see README "Choosing an AI provider").
# Recommended starting point: Google Gemini free tier.
LLM_PROVIDER = "gemini"
GEMINI_API_KEY = "your-gemini-api-key"
# LLM_MODEL = ""              # optional; defaults to gemini-2.5-flash
# Alternative providers:
# LLM_PROVIDER = "groq"
# GROQ_API_KEY = "your-groq-api-key"
# LLM_PROVIDER = "openrouter"
# OPENROUTER_API_KEY = "your-openrouter-key"
