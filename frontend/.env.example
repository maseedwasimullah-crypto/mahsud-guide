# MAHSUDo-guide frontend configuration (placeholders only; safe to commit).
# Copy to frontend/.env.local for local development.

# Base URL the browser uses to reach the FastAPI backend.
#   - Local dev (default): leave unset -> requests go to "/api" and Vite's dev
#     proxy forwards them to the backend (see vite.config.ts).
#   - Separate deployments: set this to the backend origin, e.g.
#       VITE_API_BASE_URL=https://mahsud-api.onrender.com/api
VITE_API_BASE_URL=

# Only used by the Vite dev server proxy; not needed in production builds.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8010
