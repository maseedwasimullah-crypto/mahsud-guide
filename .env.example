# MAHSUDo-guide — example environment file (placeholders only, never commit secrets)
# Copy to .env (backend) and fill in real values.

# Application
APP_NAME=MAHSUDo-guide API
ENVIRONMENT=development
DEBUG=false

# Database
# SQLite (development default):
DATABASE_URL=sqlite:///./mahsud.db
# PostgreSQL (production example):
# DATABASE_URL=postgresql+psycopg://mahsud_user:CHANGE_ME@db.example.com:5432/mahsud

# CORS — comma separated origins of the deployed frontend
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secrets — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Admin seed account used by `python -m app.cli create-admin`
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=CHANGE_ME_use_a_strong_password

# AI provider:
#   none              extractive answers only (works offline, no key)
#   gemini            Google Gemini   -> https://aistudio.google.com/apikey
#   groq              Groq Cloud      -> https://console.groq.com/keys
#   openrouter        OpenRouter      -> https://openrouter.ai/keys (has free models)
#   openai            OpenAI or any OpenAI-compatible endpoint
#   openai_compatible custom endpoint (also requires LLM_BASE_URL)
#   ollama            local server (needs ~8 GB+ RAM; not recommended for small VMs)
# Leave LLM_MODEL blank to use the provider's default model (see backend/app/services/llm.py).
LLM_PROVIDER=none
LLM_MODEL=
# Generic key — takes precedence over the provider-specific keys below.
LLM_API_KEY=
# Optional base URL override (required for openai_compatible).
LLM_BASE_URL=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=90

# Provider-specific API keys (set only the one you use).
# Gemini: get a key at https://aistudio.google.com/apikey (Google Cloud project).
# LLM_MODEL defaults to gemini-3.5-flash-lite for Gemini (free tier ~500 req/day).
# Set LLM_MODEL=gemini-3.8-flash for higher quality (free tier ~20 req/day).
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings: "local" (offline, no key) | "openai"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384

# Ingestion politeness
USER_AGENT=MAHSUDo-guide research bot (+https://github.com/; educational project)
FETCH_TIMEOUT_SECONDS=30
MIN_REQUEST_INTERVAL_SECONDS=1.0

# Rate limiting (per client IP, in-memory)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
